# ============================================
# .dockerignore - Exclude files dari Docker build
# ============================================

# Dependencies
node_modules/
npm-debug.log
yarn-error.log
pnpm-debug.log
.npm
.yarn

# Build & Cache
.next/
out/
dist/
build/
.cache/
.temp/
tmp/

# Environment files
.env
.env.local
.env*.local
.env.development
.env.test

# Git
.git/
.gitignore
.gitattributes
.github/

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/
.nyc_output/
*.lcov
jest.config.*
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Logs
logs/
*.log

# Docker files
Dockerfile
dockerfile
.dockerignore
docker-compose*.yml

# Documentation (tidak perlu di image)
README.md
DEPLOYMENT.md
LICENSE
CHANGELOG.md
docs/

# CI/CD
.gitlab-ci.yml
.travis.yml
.circleci/
azure-pipelines.yml

# OS files
Thumbs.db
.DS_Store

# Misc
.prettierrc
.prettierignore
.eslintrc.json
.editorconfig
